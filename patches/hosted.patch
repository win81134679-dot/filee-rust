--- /dev/null
+++ b/src/Filee.Engines/Office/MicrosoftOfficeConverter.cs
@@ -0,0 +1,515 @@
+// Filee Rust (patches/hosted.patch): Microsoft Office as the first choice for Office documents. Word, Excel and
+// PowerPoint are driven through their COM automation (the same as "Save As" / "Export to PDF" in the program). An
+// application only counts as installed after it really converted a small test file on this PC (an unlicensed,
+// half-installed or blocked Office does not), checked once per Office version and kept in
+// %LOCALAPPDATA%\Filee\msoffice-check.json. Anything Office fails on goes to LibreOffice instead.
+//
+// Safety: macros are disabled (AutomationSecurity = force disable), links are not updated, files open read-only,
+// password-protected files are refused instead of asking for a password, and a hung application is ended after a
+// time-out. A PowerPoint the user has open is shared (it is a single-instance server): only our presentation closes.
+// FILEE_MSOFFICE=off turns the engine off (tests, or a user who wants LibreOffice only).
+
+using System.Diagnostics;
+using System.Runtime.InteropServices;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using Filee.Core.Conversion;
+using Filee.Core.Formats;
+using Microsoft.Extensions.Logging;
+using Microsoft.Extensions.Logging.Abstractions;
+
+namespace Filee.Engines.Office;
+
+public sealed class MicrosoftOfficeConverter : IConverter
+{
+    internal enum App { Word, Excel, PowerPoint }
+
+    private static readonly string[] WordSources = ["docx", "docm", "dotx", "doc", "dot", "rtf", "odt"];
+    private static readonly string[] WordTargets = ["docx", "doc", "rtf", "odt"];
+    private static readonly string[] ExcelSources = ["xlsx", "xlsm", "xls", "ods", "csv"];
+    private static readonly string[] ExcelTargets = ["xlsx", "xls", "ods", "csv"];
+    private static readonly string[] PowerPointSources = ["pptx", "pptm", "ppsx", "ppt", "odp"];
+    private static readonly string[] PowerPointTargets = ["pptx", "ppt", "odp"];
+
+    /// <summary>PDF: cheaper than every other route, LibreOffice's preferred slides included (it comes later in the list).</summary>
+    private const int PdfCost = 0;
+    /// <summary>Editable formats: cheaper than LibreOffice (25), dearer than the built-in engines where they can do it.</summary>
+    private const int SaveAsCost = 9;
+
+    private static readonly TimeSpan CheckTimeout = TimeSpan.FromSeconds(90);
+    private static readonly TimeSpan ConvertTimeout = TimeSpan.FromMinutes(5);
+    /// <summary>A failed check is tried again after this long (Office may have been activated since).</summary>
+    private static readonly TimeSpan RecheckFailed = TimeSpan.FromDays(1);
+    private const string NoPassword = "filee-none"; // deliberately wrong: a protected file fails instead of asking
+
+    private readonly IConverter? _fallback;
+    private readonly ILogger _logger;
+    private readonly SemaphoreSlim _oneAtATime = new(1, 1);
+    private Dictionary<App, string> _usable = [];
+
+    /// <param name="fallback">LibreOffice: takes over a file Office could not convert.</param>
+    public MicrosoftOfficeConverter(IConverter? fallback = null, ILogger? logger = null)
+    {
+        _fallback = fallback;
+        _logger = logger ?? NullLogger.Instance;
+    }
+
+    public string Id => "msoffice";
+    public string DisplayName => "Microsoft Office";
+    public int MaxParallelism => 1;
+    public IReadOnlyList<ConversionEdge> Edges { get; private set; } = [];
+
+    public EngineStatus GetStatus()
+    {
+        if (!OperatingSystem.IsWindows())
+            return EngineStatus.Unavailable("engine.reason.unsupported_platform");
+        if (string.Equals(Environment.GetEnvironmentVariable("FILEE_MSOFFICE"), "off", StringComparison.OrdinalIgnoreCase))
+        {
+            _usable = [];
+            Edges = [];
+            return EngineStatus.Unavailable("engine.reason.not_installed", "FILEE_MSOFFICE=off");
+        }
+        _usable = Detect();
+        Edges = BuildEdges(_usable.Keys);
+        if (_usable.Count == 0)
+            return EngineStatus.Unavailable("engine.reason.not_installed");
+        var version = _usable.Values.Select(FileVersion).FirstOrDefault(v => v is not null);
+        return EngineStatus.Available(string.Join(", ", _usable.Keys), version);
+    }
+
+    internal static List<ConversionEdge> BuildEdges(IEnumerable<App> apps)
+    {
+        var edges = new List<ConversionEdge>();
+        foreach (var app in apps)
+        {
+            var (sources, targets) = Formats(app);
+            foreach (var s in sources)
+            {
+                edges.Add(new ConversionEdge(s, "pdf", PdfCost));
+                foreach (var t in targets)
+                    if (t != s)
+                        edges.Add(new ConversionEdge(s, t, SaveAsCost));
+            }
+        }
+        return edges;
+    }
+
+    private static (string[] Sources, string[] Targets) Formats(App app) => app switch
+    {
+        App.Word => (WordSources, WordTargets),
+        App.Excel => (ExcelSources, ExcelTargets),
+        _ => (PowerPointSources, PowerPointTargets),
+    };
+
+    private static App? AppFor(string format) =>
+        WordSources.Contains(format) ? App.Word
+        : ExcelSources.Contains(format) ? App.Excel
+        : PowerPointSources.Contains(format) ? App.PowerPoint : null;
+
+    public async Task<IReadOnlyList<string>> ConvertAsync(ConversionStep step, IProgress<double>? progress, CancellationToken cancellationToken)
+    {
+        try
+        {
+            var app = AppFor(step.From) ?? throw new NotSupportedException($"Microsoft Office does not open {step.From}.");
+            if (step.To == "pdf" && step.Preset.Document.PdfA && app != App.Word)
+                throw new NotSupportedException($"{app} cannot write PDF/A.");
+            progress?.Report(0.1);
+            var outDir = Path.Combine(step.WorkDirectory, "mso-" + Guid.NewGuid().ToString("N")[..8]);
+            Directory.CreateDirectory(outDir);
+            var produced = Path.Combine(outDir, Path.GetFileNameWithoutExtension(step.InputPath) + "." + step.To);
+            await _oneAtATime.WaitAsync(cancellationToken);
+            try
+            {
+                await RunOnStaAsync(app, () => Convert(app, step.InputPath, produced, step.To, step.Preset.Document.PdfA),
+                    ConvertTimeout, cancellationToken);
+            }
+            finally
+            {
+                _oneAtATime.Release();
+            }
+            if (!File.Exists(produced) || new FileInfo(produced).Length == 0)
+                throw new InvalidOperationException($"{app} produced no output.");
+            var target = step.Output.Allocate(step.To);
+            if (target is null)
+                return [];
+            File.Move(produced, target, overwrite: true);
+            progress?.Report(1);
+            return [target];
+        }
+        catch (Exception ex) when (ex is not OperationCanceledException || !cancellationToken.IsCancellationRequested)
+        {
+            if (_fallback is not null && _fallback.Edges.Any(e => e.From == step.From && e.To == step.To)
+                && _fallback.GetStatus().IsAvailable)
+            {
+                _logger.LogInformation("{File}: Microsoft Office could not convert it ({Error}); LibreOffice does",
+                    step.InputPath, ex.Message);
+                return await _fallback.ConvertAsync(step, progress, cancellationToken);
+            }
+            throw;
+        }
+    }
+
+    // ───────────────────────── Detection ─────────────────────────
+
+    private static string CheckFile => Path.Combine(
+        Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "Filee", "msoffice-check.json");
+
+    /// <summary>Applications that are installed and converted the test file, with their program.</summary>
+    private Dictionary<App, string> Detect()
+    {
+        var usable = new Dictionary<App, string>();
+        JsonObject cache;
+        try
+        {
+            cache = JsonNode.Parse(File.ReadAllText(CheckFile)) as JsonObject ?? [];
+        }
+        catch (Exception e) when (e is IOException or UnauthorizedAccessException or JsonException)
+        {
+            cache = [];
+        }
+        var changed = false;
+        foreach (var app in Enum.GetValues<App>())
+        {
+            var exe = RegisteredProgram(app);
+            if (exe is null)
+                continue;
+            var stamp = Stamp(exe);
+            var entry = cache[app.ToString()] as JsonObject;
+            var known = entry is not null && (string?)entry["stamp"] == stamp
+                        && (entry["ok"]?.GetValue<bool>() == true
+                            || DateTime.TryParse((string?)entry["checked"], null, System.Globalization.DateTimeStyles.RoundtripKind, out var at)
+                               && DateTime.UtcNow - at < RecheckFailed);
+            bool ok;
+            if (known)
+                ok = entry!["ok"]!.GetValue<bool>();
+            else
+            {
+                string? error = null;
+                try
+                {
+                    ok = Check(app);
+                }
+                catch (Exception e)
+                {
+                    ok = false;
+                    error = e.Message;
+                }
+                _logger.LogInformation("Microsoft Office check: {App} {Result}{Error}", app, ok ? "converts" : "does not convert",
+                    error is null ? "" : $" ({error})");
+                cache[app.ToString()] = new JsonObject
+                {
+                    ["stamp"] = stamp, ["ok"] = ok, ["checked"] = DateTime.UtcNow.ToString("O"), ["error"] = error,
+                };
+                changed = true;
+            }
+            if (ok)
+                usable[app] = exe;
+        }
+        if (changed)
+        {
+            try
+            {
+                Directory.CreateDirectory(Path.GetDirectoryName(CheckFile)!);
+                File.WriteAllText(CheckFile, cache.ToJsonString(new JsonSerializerOptions { WriteIndented = true }));
+            }
+            catch (Exception e) when (e is IOException or UnauthorizedAccessException)
+            {
+                _logger.LogInformation("Could not save {File}: {Error}", CheckFile, e.Message);
+            }
+        }
+        return usable;
+    }
+
+    /// <summary>One small file through the application, as a conversion would: true when the PDF comes out.</summary>
+    private bool Check(App app)
+    {
+        var folder = Path.Combine(Path.GetTempPath(), "filee-msoffice-" + Guid.NewGuid().ToString("N")[..8]);
+        Directory.CreateDirectory(folder);
+        try
+        {
+            var output = Path.Combine(folder, "check.pdf");
+            RunOnStaAsync(app, () => CheckOnSta(app, output), CheckTimeout, CancellationToken.None).GetAwaiter().GetResult();
+            return File.Exists(output) && new FileInfo(output).Length > 0;
+        }
+        finally
+        {
+            try
+            {
+                Directory.Delete(folder, recursive: true);
+            }
+            catch (IOException)
+            {
+            }
+        }
+    }
+
+    private static void CheckOnSta(App app, string pdf)
+    {
+        using var session = Session.Start(app);
+        dynamic office = session.Office;
+        switch (app)
+        {
+            case App.Word:
+                var doc = office.Documents.Add();
+                try
+                {
+                    doc.Content.Text = "Filee";
+                    doc.ExportAsFixedFormat(pdf, 17);
+                }
+                finally
+                {
+                    doc.Close(0);
+                }
+                break;
+            case App.Excel:
+                var book = office.Workbooks.Add();
+                try
+                {
+                    book.Worksheets[1].Range["A1"].Value2 = "Filee";
+                    book.ExportAsFixedFormat(0, pdf);
+                }
+                finally
+                {
+                    book.Close(false);
+                }
+                break;
+            default:
+                var deck = office.Presentations.Add(0);
+                try
+                {
+                    deck.Slides.Add(1, 12);
+                    deck.SaveAs(pdf, 32);
+                }
+                finally
+                {
+                    deck.Close();
+                }
+                break;
+        }
+    }
+
+    private static string? RegisteredProgram(App app)
+    {
+        if (!OperatingSystem.IsWindows())
+            return null;
+        using var progId = Microsoft.Win32.Registry.ClassesRoot.OpenSubKey(ProgId(app) + @"\CLSID");
+        if (progId?.GetValue(null) is not string clsid)
+            return null;
+        using var server = Microsoft.Win32.Registry.ClassesRoot.OpenSubKey($@"CLSID\{clsid}\LocalServer32");
+        if (server?.GetValue(null) is not string command)
+            return null;
+        // "C:\...\WINWORD.EXE" /Automation, or unquoted with arguments.
+        var exe = command.StartsWith('"') ? command[1..command.IndexOf('"', 1)] : command.Split(" /")[0].Trim();
+        return File.Exists(exe) ? exe : null;
+    }
+
+    private static string ProgId(App app) => app switch
+    {
+        App.Word => "Word.Application",
+        App.Excel => "Excel.Application",
+        _ => "PowerPoint.Application",
+    };
+
+    private static string ProcessName(App app) => app switch
+    {
+        App.Word => "WINWORD",
+        App.Excel => "EXCEL",
+        _ => "POWERPNT",
+    };
+
+    private static string Stamp(string exe)
+    {
+        var info = new FileInfo(exe);
+        return $"{exe}|{FileVersion(exe)}|{info.LastWriteTimeUtc.Ticks}";
+    }
+
+    private static string? FileVersion(string exe)
+    {
+        try
+        {
+            return FileVersionInfo.GetVersionInfo(exe).FileVersion;
+        }
+        catch (FileNotFoundException)
+        {
+            return null;
+        }
+    }
+
+    // ───────────────────────── Conversion ─────────────────────────
+
+    private static void Convert(App app, string input, string output, string to, bool pdfA)
+    {
+        using var session = Session.Start(app);
+        dynamic office = session.Office;
+        var missing = System.Reflection.Missing.Value;
+        switch (app)
+        {
+            case App.Word:
+                // FileName, ConfirmConversions, ReadOnly, AddToRecentFiles, PasswordDocument, PasswordTemplate, Revert,
+                // WritePasswordDocument, WritePasswordTemplate, Format, Encoding, Visible: a wrong password makes a
+                // protected document fail at once instead of asking.
+                var doc = office.Documents.Open(input, false, true, false, NoPassword, NoPassword, false, missing, missing,
+                    missing, missing, false);
+                try
+                {
+                    if (to == "pdf")
+                        // OutputFileName, ExportFormat (PDF), OpenAfterExport, OptimizeFor (print), Range (all), From, To,
+                        // Item (content), IncludeDocProps, KeepIRM, CreateBookmarks (headings), DocStructureTags,
+                        // BitmapMissingFonts, UseISO19005_1 (PDF/A).
+                        doc.ExportAsFixedFormat(output, 17, false, 0, 0, 1, 1, 0, true, true, 1, true, true, pdfA);
+                    else
+                        doc.SaveAs2(output, to switch { "docx" => 12, "doc" => 0, "rtf" => 6, "odt" => 23, _ => throw Unsupported(app, to) });
+                }
+                finally
+                {
+                    doc.Close(0);
+                }
+                break;
+            case App.Excel:
+                // Filename, UpdateLinks (never), ReadOnly, Format, Password, WriteResPassword, IgnoreReadOnlyRecommended.
+                // No write-reservation password: Excel refuses to open any file with a wrong one (read-only needs none).
+                var book = office.Workbooks.Open(input, 0, true, missing, NoPassword, missing, true);
+                try
+                {
+                    if (to == "pdf")
+                        // Type (PDF), Filename, Quality (standard), IncludeDocProperties, IgnorePrintAreas.
+                        book.ExportAsFixedFormat(0, output, 0, true, false);
+                    else
+                        book.SaveAs(output, to switch { "xlsx" => 51, "xls" => 56, "ods" => 60, "csv" => 62, _ => throw Unsupported(app, to) });
+                }
+                finally
+                {
+                    book.Close(false);
+                }
+                break;
+            default:
+                // "file::password::" makes a protected presentation fail instead of asking. ReadOnly, Untitled, WithWindow.
+                var deck = office.Presentations.Open(input + "::" + NoPassword + "::", -1, 0, 0);
+                try
+                {
+                    deck.SaveAs(output, to switch { "pdf" => 32, "pptx" => 24, "ppt" => 1, "odp" => 35, _ => throw Unsupported(app, to) });
+                }
+                finally
+                {
+                    deck.Close();
+                }
+                break;
+        }
+    }
+
+    private static NotSupportedException Unsupported(App app, string to) => new($"{app} does not save {to} here.");
+
+    /// <summary>
+    /// Runs Office work on a thread of its own (COM wants a single-threaded apartment). When it does not end in time
+    /// the Office processes it started, hidden ones only, are ended.
+    /// </summary>
+    private static async Task RunOnStaAsync(App app, Action work, TimeSpan timeout, CancellationToken cancellationToken)
+    {
+        var name = ProcessName(app);
+        var before = Process.GetProcessesByName(name).Select(p => p.Id).ToHashSet();
+        var started = DateTime.Now;
+        var done = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var thread = new Thread(() =>
+        {
+            try
+            {
+                work();
+                done.TrySetResult();
+            }
+            catch (Exception e)
+            {
+                done.TrySetException(e);
+            }
+        }) { IsBackground = true, Name = "Microsoft Office" };
+        thread.SetApartmentState(ApartmentState.STA);
+        thread.Start();
+        try
+        {
+            await done.Task.WaitAsync(timeout, cancellationToken);
+        }
+        catch (Exception e) when (e is TimeoutException or OperationCanceledException)
+        {
+            foreach (var p in Process.GetProcessesByName(name))
+            {
+                try
+                {
+                    if (!before.Contains(p.Id) && p.StartTime >= started.AddSeconds(-1) && p.MainWindowHandle == IntPtr.Zero)
+                        p.Kill();
+                }
+                catch (Exception kill) when (kill is InvalidOperationException or System.ComponentModel.Win32Exception)
+                {
+                }
+            }
+            if (e is TimeoutException)
+                throw new TimeoutException($"Microsoft {app} did not finish within {timeout.TotalMinutes:0.#} minutes.");
+            throw;
+        }
+    }
+
+    /// <summary>One Office application for one piece of work: quiet, macros off; quit afterwards unless it was the user's.</summary>
+    private sealed class Session : IDisposable
+    {
+        public object Office { get; }
+        private readonly bool _quit;
+
+        private Session(object office, bool quit)
+        {
+            Office = office;
+            _quit = quit;
+        }
+
+        public static Session Start(App app)
+        {
+            // Word and Excel start a new instance for automation; PowerPoint joins the running one.
+            var shared = app == App.PowerPoint && Process.GetProcessesByName(ProcessName(app)).Length > 0;
+            var type = Type.GetTypeFromProgID(ProgId(app), throwOnError: true)!;
+            dynamic office = Activator.CreateInstance(type)!;
+            var session = new Session(office, quit: !shared);
+            try
+            {
+                switch (app)
+                {
+                    case App.Word:
+                        office.Visible = false;
+                        office.DisplayAlerts = 0; // wdAlertsNone
+                        office.AutomationSecurity = 3; // msoAutomationSecurityForceDisable
+                        break;
+                    case App.Excel:
+                        office.Visible = false;
+                        office.DisplayAlerts = false;
+                        office.AskToUpdateLinks = false;
+                        office.EnableEvents = false;
+                        office.AutomationSecurity = 3;
+                        break;
+                    default:
+                        office.DisplayAlerts = 1; // ppAlertsNone
+                        office.AutomationSecurity = 3;
+                        break;
+                }
+            }
+            catch
+            {
+                session.Dispose();
+                throw;
+            }
+            return session;
+        }
+
+        public void Dispose()
+        {
+            try
+            {
+                if (_quit)
+                    ((dynamic)Office).Quit();
+            }
+            catch (Exception e) when (e is COMException or InvalidComObjectException or Microsoft.CSharp.RuntimeBinder.RuntimeBinderException)
+            {
+            }
+            finally
+            {
+                if (OperatingSystem.IsWindows())
+                    Marshal.FinalReleaseComObject(Office);
+            }
+        }
+    }
+}
