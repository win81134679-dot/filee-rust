+        timer.Tick += (_, _) =>
+        {
+            if (DateTime.UtcNow - started < TimeSpan.FromSeconds(6))
+                return;
+            var busy = desktop.Windows.Any(w => w.IsVisible)
+                       || AppHost.Get<ConversionService>().Jobs.Any(j => j.IsRunning)
+                       || RadialController.HostedPending > 0;
