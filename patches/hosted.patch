+/// <summary>
+/// Filee Rust (<c>Filee.exe --hosted --self-update</c>, started by filee-rust.exe once a day or from its tray, no
+/// window): finds the newest release of Filee Rust that is newer than this one and meant for this machine, downloads
+/// its installer (resuming a partial download) and checks it. Every release carries <c>update.json</c> (version,
+/// installer name, size, SHA-256, optional list of machine ids) and <c>update.sig</c> (ECDSA P-256 / SHA-256 over the
+/// exact bytes of update.json, DER, base64), signed with the publisher's key; the public key ships with filee-rust.exe.
+/// Nothing unsigned, older or meant for other machines is taken. Versions are Filee Rust's own from 1.9 on ("1.9" in
+/// <c>release</c>); <c>version</c> then holds an old-style <c>2.2.0-rust.N</c> for the copies up to 2.2.0-rust.9.
+/// Inputs (environment): FILEE_RUST_UPDATE_REPO
+/// (owner/repo), FILEE_RUST_CURRENT (version), FILEE_RUST_MACHINE (this machine's id), FILEE_RUST_UPDATE_KEY (public
+/// key PEM file), FILEE_RUST_UPDATE_DIR (download folder); FILEE_RUST_UPDATE_API (tests: another API base, may be http).
+/// Output, one line each: <c>current &lt;v&gt;</c> | <c>available &lt;v&gt;</c> | <c>progress &lt;done&gt; &lt;total&gt;</c> |
+/// <c>ready &lt;v&gt; &lt;path&gt;</c> | <c>failed &lt;reason&gt;</c>. Exit code 0 = current or ready, 1 = failed.
+/// </summary>
+internal static class FileeRustSelfUpdate
+{
+    private static readonly System.Text.RegularExpressions.Regex VersionPattern =
+        new(@"^(\d+)\.(\d+)\.(\d+)-(?:rust|lite)\.(\d+)$", System.Text.RegularExpressions.RegexOptions.CultureInvariant);
+    private static readonly System.Text.RegularExpressions.Regex OwnVersionPattern =
+        new(@"^(\d+)\.(\d+)(?:\.(\d+))?$", System.Text.RegularExpressions.RegexOptions.CultureInvariant);
+
+    public static int Run(ILogger log)
+    {
+        try
+        {
+            return RunAsync(log).GetAwaiter().GetResult();
+        }
+        catch (Exception ex)
+        {
+            log.LogWarning(ex, "Filee Rust self-update failed");
+            Console.WriteLine($"failed {ex.Message}");
+            return 1;
+        }
+    }
+
+    /// <summary>
+    /// Version as comparable numbers: (1, major, minor, patch, 0) for Filee Rust's own "1.9" / "1.9.2", newer than every
+    /// (0, upstream major, minor, patch, Filee Rust revision) of a "2.2.0-rust.9"; null when it is neither
+    /// (filee-rust.exe's core::self_update::parse_version).
+    /// </summary>
+    internal static int[]? ParseVersion(string? text)
+    {
+        text = (text ?? "").Trim();
+        if (OwnVersionPattern.Match(text) is { Success: true } own)
+            return [1, int.Parse(own.Groups[1].Value), int.Parse(own.Groups[2].Value),
+                    own.Groups[3].Success ? int.Parse(own.Groups[3].Value) : 0, 0];
+        var m = VersionPattern.Match(text);
+        return m.Success ? [0, .. m.Groups.Cast<System.Text.RegularExpressions.Group>().Skip(1).Select(g => int.Parse(g.Value))] : null;
+    }
+
+    internal static int Compare(int[] a, int[] b)
+    {
+        for (var i = 0; i < 5; i++)
+            if (a[i] != b[i])
+                return a[i].CompareTo(b[i]);
+        return 0;
+    }
+
+    internal static bool Verify(byte[] manifest, string signatureBase64, string publicKeyPem)
+    {
+        using var key = System.Security.Cryptography.ECDsa.Create();
+        key.ImportFromPem(publicKeyPem);
+        byte[] signature;
+        try
+        {
+            signature = Convert.FromBase64String(signatureBase64.Trim());
+        }
+        catch (FormatException)
+        {
+            return false;
+        }
+        return key.VerifyData(manifest, signature, System.Security.Cryptography.HashAlgorithmName.SHA256,
+            System.Security.Cryptography.DSASignatureFormat.Rfc3279DerSequence);
+    }
+
+    private static string Need(string name) =>
+        Environment.GetEnvironmentVariable(name) is { Length: > 0 } v ? v : throw new InvalidOperationException(name + " is not set");
+
+    private static async Task<int> RunAsync(ILogger log)
+    {
+        var repo = Need("FILEE_RUST_UPDATE_REPO");
+        var currentText = Need("FILEE_RUST_CURRENT").Trim();
+        var current = ParseVersion(currentText) ?? throw new InvalidOperationException("FILEE_RUST_CURRENT is not a version");
+        var machine = Need("FILEE_RUST_MACHINE").Trim();
+        var publicKey = await File.ReadAllTextAsync(Need("FILEE_RUST_UPDATE_KEY"));
+        var folder = Need("FILEE_RUST_UPDATE_DIR");
+        var api = Environment.GetEnvironmentVariable("FILEE_RUST_UPDATE_API") is { Length: > 0 } a ? a.TrimEnd('/') : "https://api.github.com";
+        var testing = api != "https://api.github.com";
+        Directory.CreateDirectory(folder);
+
+        using var http = new HttpClient { Timeout = TimeSpan.FromMinutes(2) };
+        http.DefaultRequestHeaders.UserAgent.ParseAdd($"FileeRust/{currentText}");
+        http.DefaultRequestHeaders.Accept.ParseAdd("application/vnd.github+json");
+
+        using var releases = System.Text.Json.JsonDocument.Parse(await http.GetStringAsync($"{api}/repos/{repo}/releases?per_page=10"));
+        (int[] Version, string Text, string Installer, long Size, string Sha256, string Url)? best = null;
+        foreach (var release in releases.RootElement.EnumerateArray())
+        {
+            if (release.TryGetProperty("draft", out var draft) && draft.GetBoolean())
+                continue;
+            string? Asset(string name) => release.GetProperty("assets").EnumerateArray()
+                .Where(x => x.GetProperty("name").GetString() == name)
+                .Select(x => x.GetProperty("browser_download_url").GetString()).FirstOrDefault();
+            if (Asset("update.json") is not { } manifestUrl || Asset("update.sig") is not { } sigUrl)
+                continue;
+            var manifest = await http.GetByteArrayAsync(Checked(manifestUrl, testing));
+            var signature = await http.GetStringAsync(Checked(sigUrl, testing));
+            var tag = release.GetProperty("tag_name").GetString();
+            if (!Verify(manifest, signature, publicKey))
+            {
+                log.LogWarning("Filee Rust self-update: {Tag} has a bad signature; ignored", tag);
+                Console.WriteLine($"bad-signature {tag}");
+                continue;
+            }
+            using var doc = System.Text.Json.JsonDocument.Parse(manifest);
+            var root = doc.RootElement;
+            var text = (root.TryGetProperty("release", out var own) ? own : root.GetProperty("version")).GetString() ?? "";
+            if (ParseVersion(text) is not { } version || Compare(version, current) <= 0)
+                continue;
+            if (root.TryGetProperty("machines", out var machines) && machines.ValueKind == System.Text.Json.JsonValueKind.Array
+                && !machines.EnumerateArray().Any(m => string.Equals(m.GetString(), machine, StringComparison.OrdinalIgnoreCase)))
+            {
+                Console.WriteLine($"not-for-this-machine {text}");
+                continue;
+            }
+            var installer = Path.GetFileName(root.GetProperty("file").GetString() ?? "");
+            if (installer.Length == 0 || Asset(installer) is not { } installerUrl)
+                continue;
+            if (best is null || Compare(version, best.Value.Version) > 0)
+                best = (version, text, installer, root.GetProperty("size").GetInt64(), root.GetProperty("sha256").GetString() ?? "", installerUrl);
+        }
+        if (best is not { } b)
+        {
+            Console.WriteLine($"current {currentText}");
+            return 0;
+        }
+        Console.WriteLine($"available {b.Text}");
+        foreach (var stale in Directory.EnumerateFiles(folder))
+            if (!Path.GetFileName(stale).StartsWith(b.Installer, StringComparison.OrdinalIgnoreCase))
+                File.Delete(stale);
+
+        var target = Path.Combine(folder, b.Installer);
+        var part = target + ".part";
+        if (File.Exists(target) && new FileInfo(target).Length == b.Size && Sha256Of(target) == b.Sha256.ToLowerInvariant())
+        {
+            Console.WriteLine($"ready {b.Text} {target}");
+            return 0;
+        }
+        File.Delete(target);
+        if (File.Exists(part) && new FileInfo(part).Length > b.Size)
+            File.Delete(part);
+        await Download(http, Checked(b.Url, testing), part, b.Size);
+        if (new FileInfo(part).Length != b.Size || Sha256Of(part) != b.Sha256.ToLowerInvariant())
+        {
+            File.Delete(part);
+            Console.WriteLine("failed the download does not match update.json");
+            return 1;
+        }
+        File.Move(part, target);
+        log.LogInformation("Filee Rust self-update: {Version} downloaded to {Path}", b.Text, target);
+        Console.WriteLine($"ready {b.Text} {target}");
+        return 0;
+    }
+
+    private static string Checked(string url, bool testing) =>
+        url.StartsWith("https://", StringComparison.OrdinalIgnoreCase) || testing ? url : throw new InvalidOperationException("not https: " + url);
+
+    private static string Sha256Of(string path)
+    {
+        using var stream = File.OpenRead(path);
+        return Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(stream)).ToLowerInvariant();
+    }
+
+    /// <summary>Appends to <paramref name="part"/> from where it stopped (HTTP Range), printing progress.</summary>
+    private static async Task Download(HttpClient http, string url, string part, long size)
+    {
+        var have = File.Exists(part) ? new FileInfo(part).Length : 0;
+        if (have == size)
+            return;
+        using var request = new HttpRequestMessage(HttpMethod.Get, url);
+        request.Headers.Accept.Clear();
+        request.Headers.Accept.ParseAdd("application/octet-stream");
+        if (have > 0)
+            request.Headers.Range = new System.Net.Http.Headers.RangeHeaderValue(have, null);
+        using var response = await http.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
+        response.EnsureSuccessStatusCode();
+        if (have > 0 && response.StatusCode != System.Net.HttpStatusCode.PartialContent)
+            have = 0; // the server sent the whole file
+        await using var body = await response.Content.ReadAsStreamAsync();
+        await using var file = new FileStream(part, have > 0 ? FileMode.Append : FileMode.Create, FileAccess.Write);
+        var buffer = new byte[81920];
+        var lastShown = -1L;
+        while (true)
+        {
+            using var idle = new CancellationTokenSource(TimeSpan.FromSeconds(60));
+            var read = await body.ReadAsync(buffer, idle.Token);
+            if (read == 0)
+                break;
+            await file.WriteAsync(buffer.AsMemory(0, read));
+            have += read;
+            var step = have * 20 / Math.Max(size, 1);
+            if (step != lastShown)
+            {
+                lastShown = step;
+                Console.WriteLine($"progress {have} {size}");
+            }
+        }
+    }
+}
