+/// <summary>
+/// Filee Rust (<c>Filee.exe --hosted --update-engines[=ids]</c>, started weekly by filee-rust.exe, no window): brings
+/// the engines Filee downloaded, and the 7-Zip next to Filee.exe, up to the newest pinned version. The pins are this
+/// build's engines.json, or the latest Filee release's where that one is newer and comes from the same publisher (same
+/// host; same owner/repo on github.com, same channel on conda.anaconda.org). Every download is SHA-256 checked by
+/// EngineInstaller as usual. Packages in <c>ids</c> are installed when missing. Exit code 0 = up to date, 1 = a
+/// package failed (filee-rust.exe tries again the next day). One line per package on standard output.
+/// FILEE_LITE_ENGINES_DIR (tests) puts both engine folders there.
+/// </summary>
+internal static class FileeRustEngineUpdate
+{
+    private const string LatestRelease = "https://api.github.com/repos/KnifeLemon/Filee/releases/latest";
+    private const string ManifestAt = "https://raw.githubusercontent.com/KnifeLemon/Filee/{0}/src/Filee.Engines/Infrastructure/engines.json";
+
+    public static int Run(IReadOnlyList<string> install, ILogger log)
+    {
+        try
+        {
+            return RunAsync(install, log).GetAwaiter().GetResult();
+        }
+        catch (Exception ex)
+        {
+            log.LogWarning(ex, "Filee Rust engine update failed");
+            Console.WriteLine($"failed: {ex.Message}");
+            return 1;
+        }
+    }
+
+    private static async Task<int> RunAsync(IReadOnlyList<string> install, ILogger log)
+    {
+        var testRoot = Environment.GetEnvironmentVariable("FILEE_LITE_ENGINES_DIR");
+        var downloadRoot = string.IsNullOrWhiteSpace(testRoot) ? EngineEnvironment.DownloadRoot : testRoot;
+        var bundledRoot = string.IsNullOrWhiteSpace(testRoot) ? Path.Combine(AppContext.BaseDirectory, "engines") : testRoot;
+        // Redirects are followed by the installer (mirrors may use plain HTTP; files are verified by SHA-256).
+        using var http = new HttpClient(new SocketsHttpHandler { AllowAutoRedirect = false }) { Timeout = Timeout.InfiniteTimeSpan };
+        http.DefaultRequestHeaders.UserAgent.ParseAdd($"Filee/{typeof(Program).Assembly.GetName().Version} FileeLite");
+
+        var built = EngineDownloads.Components;
+        var pins = new Dictionary<string, EngineComponent>(built);
+        foreach (var newer in await NewerPinsAsync(http, built, log))
+        {
+            pins[newer.Id] = newer;
+            Console.WriteLine($"pin {newer.Id} {built[newer.Id].Version} -> {newer.Version}");
+        }
+
+        var failed = 0;
+        async Task Update(EngineInstaller installer, EnginePackage package)
+        {
+            try
+            {
+                await installer.InstallAsync(package, null, CancellationToken.None);
+                Console.WriteLine($"updated {package.Id} {string.Join(" ", package.Components.Select(c => pins[c].Version))}");
+            }
+            catch (Exception ex) when (ex is not OutOfMemoryException)
+            {
+                failed++;
+                log.LogWarning(ex, "Filee Rust engine update: {Package} failed", package.Id);
+                Console.WriteLine($"failed {package.Id}: {ex.Message}");
+            }
+        }
+
+        var downloaded = new EngineInstaller(http, downloadRoot, pins, log);
+        foreach (var package in EngineDownloads.Packages.Where(EngineDownloads.CanDownload))
+        {
+            var present = downloaded.IsInstalled(package);
+            if (present ? downloaded.IsUpToDate(package) : !install.Contains(package.Id))
+            {
+                Console.WriteLine(present ? $"current {package.Id}" : $"absent {package.Id}");
+                continue;
+            }
+            await Update(downloaded, package);
+        }
+
+        // 7-Zip opens untrusted archives and disc images, so it is kept current too. The copy shipped next to
+        // Filee.exe has no marker: it is the version this build pins.
+        var sevenZip = new EnginePackage("7zip", ["7zip"], 0, ["archive"]);
+        var bundled = new EngineInstaller(http, bundledRoot, pins, log);
+        var shipped = Directory.Exists(Path.Combine(bundledRoot, "7zip"));
+        var stale = bundled.IsInstalled(sevenZip) ? !bundled.IsUpToDate(sevenZip)
+            : shipped ? !string.Equals(pins["7zip"].Sha256, built["7zip"].Sha256, StringComparison.OrdinalIgnoreCase)
+            : install.Contains("7zip");
+        if (stale && shipped && !Writable(bundledRoot))
+            // Installed for all users (Program Files): it is updated with Filee Rust itself.
+            Console.WriteLine($"read-only 7zip {pins["7zip"].Version} (installed for all users; reinstall Filee Rust to update it)");
+        else if (stale)
+            await Update(bundled, sevenZip);
+        else
+            Console.WriteLine(shipped ? "current 7zip" : "absent 7zip");
+
+        log.LogInformation("Filee Rust engine update done, {Failed} failed", failed);
+        return failed == 0 ? 0 : 1;
+    }
+
+    private static bool Writable(string folder)
+    {
+        try
+        {
+            var probe = Path.Combine(folder, $".filee-write-{Environment.ProcessId}");
+            File.WriteAllText(probe, "");
+            File.Delete(probe);
+            return true;
+        }
+        catch (Exception e) when (e is IOException or UnauthorizedAccessException)
+        {
+            return false;
+        }
+    }
+
+    /// <summary>Pins of the latest Filee release that are newer than <paramref name="built"/> and trusted.</summary>
+    private static async Task<List<EngineComponent>> NewerPinsAsync(HttpClient http, IReadOnlyDictionary<string, EngineComponent> built, ILogger log)
+    {
+        var newer = new List<EngineComponent>();
+        try
+        {
+            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
+            using var release = System.Text.Json.JsonDocument.Parse(await http.GetStringAsync(LatestRelease, cts.Token));
+            var tag = release.RootElement.GetProperty("tag_name").GetString() ?? "";
+            if (tag.Length is 0 or > 40 || !tag.All(c => char.IsAsciiLetterOrDigit(c) || c is '.' or '-' or '_'))
+                return newer;
+            using var manifest = System.Text.Json.JsonDocument.Parse(await http.GetStringAsync(string.Format(ManifestAt, tag), cts.Token));
+            foreach (var p in manifest.RootElement.GetProperty("components").EnumerateObject())
+            {
+                if (!built.TryGetValue(p.Name, out var pin))
+                    continue;
+                var candidate = new EngineComponent(p.Name, p.Value.GetProperty("version").GetString() ?? "",
+                    p.Value.GetProperty("url").GetString() ?? "", p.Value.GetProperty("sha256").GetString() ?? "",
+                    p.Value.GetProperty("size").GetInt64(), p.Value.GetProperty("kind").GetString() ?? "");
+                if (IsTrustedNewer(pin, candidate))
+                    newer.Add(candidate);
+            }
+            Console.WriteLine($"manifest {tag}");
+        }
+        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException or System.Text.Json.JsonException
+                                       or KeyNotFoundException or InvalidOperationException or FormatException)
+        {
+            log.LogInformation("Filee Rust engine update: latest pins unavailable ({Error}); using this build's", ex.Message);
+            Console.WriteLine($"manifest unavailable: {ex.Message}");
+        }
+        return newer;
+    }
+
+    internal static bool IsTrustedNewer(EngineComponent pin, EngineComponent candidate)
+    {
+        if (candidate.Kind != pin.Kind || candidate.Size is <= 0 or > 2_000_000_000
+            || candidate.Sha256.Length != 64 || !candidate.Sha256.All(char.IsAsciiHexDigit)
+            || !Uri.TryCreate(candidate.Url, UriKind.Absolute, out var url) || url.Scheme != Uri.UriSchemeHttps
+            || !Uri.TryCreate(pin.Url, UriKind.Absolute, out var old) || !url.Host.Equals(old.Host, StringComparison.OrdinalIgnoreCase))
+            return false;
+        // The publisher on a shared host: github.com/<owner>/<repo>/, conda.anaconda.org/<channel>/ (Segments[0] is "/").
+        var publisher = old.Host.ToLowerInvariant() switch { "github.com" => 2, "conda.anaconda.org" => 1, _ => 0 };
+        if (!url.Segments.Take(publisher + 1).SequenceEqual(old.Segments.Take(publisher + 1), StringComparer.OrdinalIgnoreCase))
+            return false;
+        return CompareVersions(candidate.Version, pin.Version) > 0;
+    }
+
+    /// <summary>Compares the numbers in two version texts ("21.0.12.1", "5.4.0.20240606") one by one.</summary>
+    internal static int CompareVersions(string a, string b)
+    {
+        static long[] Numbers(string v) => System.Text.RegularExpressions.Regex.Matches(v, "[0-9]+")
+            .Select(m => long.TryParse(m.Value, out var n) ? n : 0).ToArray();
+        var (x, y) = (Numbers(a), Numbers(b));
+        for (var i = 0; i < Math.Max(x.Length, y.Length); i++)
+        {
+            var c = (i < x.Length ? x[i] : 0).CompareTo(i < y.Length ? y[i] : 0);
+            if (c != 0)
+                return c;
+        }
+        return 0;
+    }
+}
